{
  "name": "ytd",
  "version": "1.7.10",
  "description": "YouTube Downloader Desktop Application",
  "main": "dist/desktop/index.js",
  "author": "Jerome Purushotham",
  "license": "MIT",
  "scripts": {
    "test": "vitest run tests/app.test.ts",
    "test:integration": "vitest run tests/download.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.main.json && electron .",
    "prebuild": "node -e \"const{config}=require('dotenv');config();const fs=require('fs');fs.mkdirSync('dist',{recursive:true});const c={clientId:process.env.GOOGLE_CLIENT_ID||'',clientSecret:process.env.GOOGLE_CLIENT_SECRET||''};if(c.clientId)fs.writeFileSync('dist/oauth-config.json',JSON.stringify(c));\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "download-bins": "bash scripts/download-binaries.sh",
    "dist": "npm run build && electron-builder build --mac --publish never",
    "dist:win": "npm run build && electron-builder build --win",
    "dist:linux": "npm run build && electron-builder build --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.0",
    "dotenv": "^16.4.0",
    "electron-updater": "^6.3.0",
    "google-auth-library": "^11.3.3",
    "googleapis": "^189.0.0",
    "node-cron": "^4.2.1",
    "winston": "^3.19.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "^5.1.0",
    "concurrently": "^9.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wait-on": "^8.0.1"
  }
}
